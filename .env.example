# ClashCode environment variables
# Copy this file to .env and fill in your API keys.
# At minimum, set one provider key.

# xAI (default provider)
XAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Optional: custom API base URL for OpenAI-compatible endpoints
# CLASHCODE_BASE_URL=http://localhost:11434/v1

# Optional: log verbosity — debug|info|warn|error|silent (default: info)
# CLASHCODE_LOG_LEVEL=info

# Optional: force interactive TUI on/off. By default it auto-detects
# whether stderr is a TTY. Useful for logging or screenshots.
# CLASHCODE_NO_TUI=1
# CLASHCODE_FORCE_TUI=1

# Optional: OpenTelemetry metrics export. Set to an OTLP endpoint URL.
# Requires: pnpm add @opentelemetry/api @opentelemetry/sdk-metrics @opentelemetry/exporter-metrics-otlp-http
# CLASHCODE_OTEL_ENDPOINT=http://localhost:4317
# CLASHCODE_OTEL_SERVICE=clashcode

# Optional: Sentry crash reporting. Requires: pnpm add @sentry/node
# CLASHCODE_SENTRY_DSN=https://abc@sentry.io/123
# CLASHCODE_ENV=production
